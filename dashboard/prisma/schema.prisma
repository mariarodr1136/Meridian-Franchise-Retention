// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Studio {
  id             String            @id @default(cuid())
  name           String
  city           String
  state          String?
  country        String            @default("US")
  region         String
  status         String            @default("healthy")
  openedAt       DateTime?
  franchiseeName String
  address        String?
  phone          String?
  email          String?
  metrics        StudioMetric[]
  instructors    Instructor[]
  anomalies      Anomaly[]
  reviews        Review[]
  classMetrics   ClassMetric[]
  operations     StudioOperations?
  salesRecords        SalesRecord[]
  inventoryItems      InventoryItem[]
  maintenanceItems    MaintenanceItem[]
  createdAt           DateTime          @default(now())
}

model StudioOperations {
  id                    String    @id @default(cuid())
  studioId              String    @unique
  studio                Studio    @relation(fields: [studioId], references: [id])
  leaseExpiresAt        DateTime?
  landlordName          String?
  landlordPhone         String?
  landlordEmail         String?
  alarmCompany          String?
  alarmCode             String?
  alarmPhone            String?
  hvacCompany           String?
  hvacPhone             String?
  hvacContractExpiresAt DateTime?
  electricianName       String?
  electricianPhone      String?
  internetProvider      String?
  wifiPassword          String?
  notes                 String?
  updatedAt             DateTime  @updatedAt
  createdAt             DateTime  @default(now())
}

model SalesRecord {
  id        String   @id @default(cuid())
  studioId  String
  studio    Studio   @relation(fields: [studioId], references: [id])
  month     DateTime
  category  String
  product   String
  unitsSold Int
  revenue   Float
  createdAt DateTime @default(now())
}

model InventoryItem {
  id           String   @id @default(cuid())
  studioId     String
  studio       Studio   @relation(fields: [studioId], references: [id])
  month        DateTime
  name         String
  category     String
  openingQty   Int
  receivedQty  Int
  usedQty      Int
  closingQty   Int
  reorderPoint Int      @default(10)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model StudioMetric {
  id                    String   @id @default(cuid())
  studioId              String
  studio                Studio   @relation(fields: [studioId], references: [id])
  weekOf                DateTime
  classFillRate         Float
  activeMemberships     Int
  weeklyChurn           Float
  weeklyRevenue         Float
  presalesPipelineCount Int      @default(0)
  memberBookings        Int      @default(0)
  classPackBookings     Int      @default(0)
  classPassBookings     Int      @default(0)
  createdAt             DateTime @default(now())
}

model Instructor {
  id                  String    @id @default(cuid())
  studioId            String
  studio              Studio    @relation(fields: [studioId], references: [id])
  name                String
  role                String    @default("instructor")
  certificationStatus String    @default("certified")
  email               String?
  phone               String?
  lastEvalDate        DateTime?
  performanceScore    Float?
  personKey           String?
  reviews             Review[]
  createdAt           DateTime  @default(now())

  @@index([personKey])
}

model ClassMetric {
  id                String   @id @default(cuid())
  studioId          String
  studio            Studio   @relation(fields: [studioId], references: [id])
  dayOfWeek         Int
  timeSlot          String
  weekOf            DateTime
  capacity          Int      @default(12)
  spotsFilled       Int
  memberBookings    Int
  classPackBookings Int
  classPassBookings Int
  createdAt         DateTime @default(now())
}

model Review {
  id           String      @id @default(cuid())
  studioId     String
  studio       Studio      @relation(fields: [studioId], references: [id])
  instructorId String?
  instructor   Instructor? @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  source       String
  author       String
  rating       Int
  body         String
  reviewDate   DateTime
  createdAt    DateTime    @default(now())

  @@index([instructorId])
}

model Anomaly {
  id          String   @id @default(cuid())
  studioId    String?
  studio      Studio?  @relation(fields: [studioId], references: [id])
  generatedAt DateTime @default(now())
  summary     String
  severity    String   @default("medium")
  category    String
  resolved    Boolean  @default(false)
}

model MaintenanceItem {
  id          String    @id @default(cuid())
  studioId    String
  studio      Studio    @relation(fields: [studioId], references: [id])
  reportedAt  DateTime  @default(now())
  category    String    // "reformer" | "mirror" | "sound" | "facility" | "straps" | "springs"
  equipment   String?   // "Reformer #4", "Mirror – East Wall", "Bluetooth Speaker"
  description String
  priority    String    @default("medium") // "urgent" | "medium" | "low"
  status      String    @default("open")   // "open" | "resolved"
  resolvedAt  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model FranchiseLead {
  id              String   @id @default(cuid())
  franchiseeName  String
  market          String
  state           String?
  country         String   @default("US")
  assignedTo      String
  stage           String   @default("Discovery")
  stageEnteredAt  DateTime @default(now())
  expectedOpenDate DateTime?
  territoryType   String   @default("suburban")
  notes           String?
  docsComplete    Boolean  @default(false)
  leaseComplete   Boolean  @default(false)
  trainingBooked  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
